{
  "name": "skyfold",
  "private": true,
  "version": "0.3.0",
  "type": "module",
  "description": "Explore the real universe at nearly the speed of light: the true-scale Solar System, real stars in 3D, the Milky Way and the galaxies beyond, with exact relativistic optics and flights through expanding space, in the browser.",
  "license": "MIT",
  "author": "Tommy S. Liu (https://github.com/tommysl8)",
  "homepage": "https://skyfold-space.vercel.app",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tommysl8/skyfold.git"
  },
  "bugs": {
    "url": "https://github.com/tommysl8/skyfold/issues"
  },
  "engines": {
    "node": "^22.12.0 || ^24.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b",
    "data:stars": "node scripts/build-stars3d.mjs && node scripts/build-constellations.mjs && node scripts/build-stars3d-bright.mjs && node --max-old-space-size=10000 scripts/build-stars3d-ext.mjs",
    "data:asteroids": "node --max-old-space-size=6000 scripts/build-asteroids.mjs && node --max-old-space-size=6000 scripts/asteroids/notable.mjs",
    "data:exoplanets": "node scripts/build-exoplanets.mjs",
    "data:exoplanets-featured": "node scripts/build-exoplanets-featured.mjs",
    "data:cosmic-web": "node scripts/build-cosmic-web.mjs",
    "data:local-galaxies": "node scripts/build-local-galaxies.mjs",
    "data:cmb": "node scripts/build-cmb.mjs",
    "data:field-sky": "node scripts/build-field-sky.mjs --source wmap",
    "data:surveys": "node --max-old-space-size=8000 scripts/build-surveys.mjs",
    "data:deepsky": "node scripts/build-ngc.mjs && node scripts/build-pulsars.mjs && node scripts/build-snrs.mjs && node --max-old-space-size=4000 scripts/build-gw-events.mjs",
    "data:quaia": "node --max-old-space-size=6000 scripts/build-quaia.mjs",
    "data:faint-stars": "node scripts/build-faint-stars.mjs",
    "data:galaxy-face": "node --max-old-space-size=8000 scripts/build-galaxy-face.mjs",
    "data:nsc": "python scripts/build-nsc.py",
    "data:blackhole-fixtures": "python scripts/schwarzschild/make_fixtures.py --subset",
    "data:disk-fixtures": "python scripts/thin-disk/disk_ref.py",
    "check:shaders": "node scripts/check-shaders.mjs"
  },
  "dependencies": {
    "@fontsource-variable/ibm-plex-sans": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/source-serif-4": "^5.3.0",
    "@react-three/fiber": "^9.8.0",
    "astronomy-engine": "^2.1.19",
    "katex": "^0.18.9",
    "markdown-it": "^14.3.2",
    "markdown-it-container": "^4.0.0",
    "markdown-it-footnote": "^4.0.0",
    "postprocessing": "^6.39.5",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "three": "^0.186.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/markdown-it": "^14.2.0",
    "@types/markdown-it-container": "^4.0.1",
    "@types/markdown-it-footnote": "^3.0.4",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.1"
  }
}
